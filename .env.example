# Configure as variáveis no serviço que executa o backend Milk (AI Studio/Cloud Run).
# Use sempre URL e chave pública do MESMO projeto, nunca uma chave do Cartório One.
# Não inclua credenciais reais neste arquivo, em comentários ou no GitHub.
GEMINI_API_KEY=
APP_URL=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Compatibilidade com chave anon pública legada (não configure as duas)
SUPABASE_ANON_KEY=

# Variáveis públicas exclusivamente do build do GitHub Pages.
# Estas NÃO configuram o servidor Google AI Studio/Cloud Run.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_ANON_KEY=

# Nunca usar sb_secret_ ou service_role no navegador/servidor antigo sem
# autenticação e verificação de propriedade por família.
